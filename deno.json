{
  "$schema": "https://raw.githubusercontent.com/denoland/deno/refs/heads/main/cli/schemas/config-file.v1.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx"
  },
  "imports": {
    "@/": "./src/"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "exclude": ["require-await", "no-unused-vars"]
    }
  },
  "fmt": {
    "bracePosition": "sameLine",
    "jsx.bracketPosition": "sameLine",
    "jsx.multiLineParens": "prefer",
    "indentWidth": 2,
    "lineWidth": 140,
    "nextControlFlowPosition": "sameLine",
    "semiColons": true,
    "operatorPosition": "sameLine",
    "proseWrap": "preserve",
    "quoteProps": "consistent",
    "singleBodyPosition": "sameLine",
    "singleQuote": false,
    "spaceAround": false,
    "spaceSurroundingProperties": true,
    "trailingCommas": "never",
    "typeLiteral.separatorKind": "semiColon",
    "useTabs": false,
    "useBraces": "always"
  },
  "exclude": [
    "/build/",
    "/dist/",
    "/out/",
    "/out-tsc/",
    "/tmp/",
    "/.output/",
    "/coverage/",
    "*.tgz",
    "/node_modules/",
    "/jspm_packages/",
    "/.pnp",
    ".pnp.*",
    ".yarn/*",
    ".npm",
    ".yarn-integrity",
    ".pnpm-store",
    ".lock-wscript",
    ".astro/",
    ".next/",
    ".nuxt/",
    ".vercel/",
    ".svelte-kit/",
    ".vitepress/cache/",
    ".vitepress/dist/",
    ".turbo/",
    ".netlify/",
    "/.wrangler",
    "pids",
    "*.pid",
    "*.seed",
    "*.pid.lock",
    ".lcov",
    ".nyc_output/",
    ".vitest/",
    ".playwright/",
    "playwright-report/",
    "test-results/",
    ".lib-cov",
    ".grunt",
    "typings/",
    "logs/",
    "*.log",
    "npm-debug.log*",
    "yarn-debug.log*",
    "yarn-error.log*",
    "pnpm-debug.log*",
    "lerna-debug.log*",
    ".env*",
    ".dev.vars",
    "*.tsbuildinfo",
    "next-env.d.ts",
    ".deno/",
    ".bun",
    ".DS_Store",
    "._*",
    ".Spotlight-V100",
    ".Trashes",
    "ehthumbs.db",
    "Thumbs.db",
    "*.pem",
    "*.key",
    "*.cert",
    ".idea/",
    ".project",
    ".classpath",
    ".c9/",
    "*.launch",
    "*.sublime-workspace",
    "*.sublime-project",
    ".vscode/*",
    "!.vscode/settings.json",
    "!.vscode/tasks.json",
    "!.vscode/launch.json",
    "!.vscode/extensions.json",
    "*.swp",
    "*.swo",
    "*~",
    "storybook-static/",
    ".sentryclirc",
    "*.lock",
    "*.lockb",
    "npm-shrinkwrap.json",
    "pnpm-lock.yaml"
  ]
}
