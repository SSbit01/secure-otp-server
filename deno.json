{
  "$schema": "https://raw.githubusercontent.com/denoland/deno/refs/heads/main/cli/schemas/config-file.v1.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx"
  },
  "imports": {
    "@/": "./src/"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "exclude": ["require-await", "no-unused-vars"]
    }
  },
  "fmt": {
    "bracePosition": "sameLine",
    "jsx.bracketPosition": "sameLine",
    "jsx.forceNewLineSurroundingContent": false,
    "jsx.multiLineParens": "prefer",
    "indentWidth": 2,
    "lineWidth": 140,
    "nextControlFlowPosition": "sameLine",
    "semiColons": false,
    "operatorPosition": "sameLine",
    "proseWrap": "preserve",
    "quoteProps": "consistent",
    "singleBodyPosition": "sameLineUnlessHanging",
    "singleQuote": false,
    "spaceAround": true,
    "spaceSurroundingProperties": true,
    "trailingCommas": "never",
    "typeLiteral.separatorKind": "semiColon",
    "useTabs": false,
    "useBraces": "always"
  },
  "exclude": [
    "/build",
    "/dist",
    "/tmp",
    "/out",
    "/out-tsc",
    ".output",
    ".astro",
    ".next",
    ".nuxt",
    ".vercel",
    ".svelte-kit",
    ".vitepress/cache",
    ".vitepress/dist",
    ".turbo",
    ".netlify",
    "pids",
    "*.pid",
    "*.seed",
    "lib-cov",
    "/coverage",
    "*.lcov",
    ".nyc_output",
    ".grunt",
    "bower_components",
    ".lock-wscript",
    ".sass-cache",
    "typings",
    "logs",
    "*.log",
    "npm-debug.log*",
    "yarn-debug.log*",
    "yarn-error.log*",
    "pnpm-debug.log*",
    "lerna-debug.log*",
    "node_modules/",
    "jspm_packages/",
    "/.pnp",
    ".pnp.*",
    ".yarn/*",
    "!.yarn/patches",
    "!.yarn/plugins",
    "!.yarn/releases",
    "!.yarn/versions",
    "!.yarn/sdks",
    "!.yarn/versions",
    ".yarn-integrity",
    ".npm",
    ".eslintcache",
    ".node_repl_history",
    ".pnpm-store",
    "*.tgz",
    ".bun",
    ".deno/",
    ".wrangler",
    "*.tsbuildinfo",
    "next-env.d.ts",
    ".DS_Store",
    ".DS_Store?",
    "._*",
    ".Spotlight-V100",
    ".Trashes",
    "ehthumbs.db",
    "Thumbs.db",
    ".vitest",
    ".playwright",
    "playwright-report/",
    "test-results/",
    "storybook-static",
    ".sentryclirc",
    "*.lock",
    "*.lockb",
    "npm-shrinkwrap.json",
    "pnpm-lock.yaml"
  ]
}