{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "lib": [
      "DOM",
      "ES2024",
      "ESNext.TypedArrays"
    ],
    "noEmit": true,
    "module": "ES2022",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "paths": {
      "@/*": ["./src/*"]
    },
    "rootDir": "./src",
    "strict": true,
    "skipLibCheck": true,
    "target": "esnext",
    "types": ["node"]
  },
  "include": ["src/**/*"]
}
