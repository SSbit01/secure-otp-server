{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "skipLibCheck": true,
    "lib": [
      "esnext",
      "dom"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true
  },
  "exclude": [".vercel", ".wrangler", "dist", "build", "node_modules"]
}