{
  "name": "secure-otp-server",
  "author": "Stefan Samson <ss42701@outlook.com> (https://ssbit01.github.io/)",
  "repository": "github:SSbit01/secure-otp-server",
  "bugs": {
    "url": "https://github.com/SSbit01/secure-otp-server/issues"
  },
  "main": "./src/index.ts",
  "description": "A template server for generating, encrypting, and verifying OTP (One-Time Password) codes. Ideal for microservices and authentication flows.",
  "homepage": "https://github.com/SSbit01/secure-otp-server#readme",
  "license": "MIT",
  "scripts": {
    "bun:dev": "bun run --hot ./src/index.ts",
    "bun:test": "bun test",
    "bun:build": "bun build --minify ./src/index.ts --outdir ./dist",
    "bun:start": "bun run ./dist/index.js",
    "deno:dev": "deno serve --watch --sloppy-imports ./src/index.ts",
    "deno:dev:parallel": "deno serve --parallel --watch --sloppy-imports ./src/index.ts",
    "deno:bundle": "deno bundle --minify ./src/index.ts --outdir ./dist",
    "deno:start": "deno serve ./dist/index.js",
    "deno:start:parallel": "deno serve --parallel ./dist/index.js",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy --minify",
    "cf:typegen": "wrangler types --env-interface CloudflareBindings",
    "vercel:dev": "vercel dev",
    "vercel:deploy": "vercel deploy"
  },
  "type": "module",
  "dependencies": {
    "hono": "^4.9.8",
    "ulid": "^3.0.1"
  },
  "devDependencies": {
    "@types/bun": "^1.2.22",
    "wrangler": "^4.38.0"
  }
}